---
# Generated by GitHub Pages (Jekyll) on every push: lists every file under src/imgs/,
# including subfolders. The controller's "Sync from GitHub" reads this file.
---
{% assign files = site.static_files | where_exp: "f", "f.path contains '/src/imgs/'" %}[
{% for f in files %}  { "path": {{ f.path | remove_first: '/src/imgs/' | jsonify }}, "modified": {{ f.modified_time | date: '%s' }} }{% unless forloop.last %},{% endunless %}
{% endfor %}]
